# =============================================================================
# mixup — environment variables
#
# Copy to `.env` (or export in your shell) and adjust. Values shown are the
# defaults. The code reads the *process* environment via os.getenv, so either
# `export` these or run with an env-file loader, e.g.:
#
#   uv run --env-file .env mixup-orchestrator
#
# See docs/config.md and docs/running.md for the full picture.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime environment — ONE typed model, ONE env var.
#
# The orchestrator serializes a `NodeEnv` (container_name, config, prompt,
# max_new_tokens) into JSON and injects it into every container as the single
# MIXUP_NODE_ENV env var. The node deserializes it at bootup. You do not set
# this yourself; documented here so the full contract is visible.
# ---------------------------------------------------------------------------

# MIXUP_NODE_ENV={"container_name":"container_1","config":{"central":"container_1","experts":{"container_2":[0,1,2,3,4,5,6,7], ...}},"prompt":"What is mixture of experts?","max_new_tokens":50}

# Generation settings are CLI flags on the orchestrator, not env vars:
#   mixup-orchestrator --prompt "..." --max-new-tokens 5

# ---------------------------------------------------------------------------
# Infrastructure — optional, consumed by the underlying tools.
# ---------------------------------------------------------------------------

# Docker daemon address (read by the docker SDK). Override if Docker is not on
# the default socket.
# Default: unix:///var/run/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock

# Hugging Face auth token. Required only if the model repo is gated/private.
# (Also honoured as HUGGING_FACE_HUB_TOKEN.)
# HF_TOKEN=hf_xxx

# Hugging Face cache root. Only relevant when `mixup-fetch-model` is used
# without an explicit --dir.
# Default: ~/.cache/huggingface
# HF_HOME=~/.cache/huggingface

# ---------------------------------------------------------------------------
# Nix dev shell — set automatically by flake.nix when you run `nix develop`.
# Not meant to be set in .env (they'd be overridden); listed for reference.
# ---------------------------------------------------------------------------
# UV_NO_SYNC=1                 # stop uv from installing its own venv
# UV_PYTHON=<nix python path>  # point uv at the Nix-built interpreter
# UV_PYTHON_DOWNLOADS=never    # stop uv from downloading an interpreter
